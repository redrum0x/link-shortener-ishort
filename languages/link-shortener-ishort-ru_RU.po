msgid "Link Shortener by iShort"
msgstr "Сокращатель ссылок iShort"

msgid "Shorten URLs directly from the WordPress editor using iShort.su service."
msgstr "Сокращайте ссылки прямо из редактора WordPress с помощью сервиса iShort.su."

msgid "iShort"
msgstr "iShort"

msgid "API Token"
msgstr "API Токен"

msgid "Get your token at <a href=\"%s\" target=\"_blank\" rel=\"noopener\">ishort.su/user/api-clients</a>"
msgstr "Получите токен на <a href=\"%s\" target=\"_blank\" rel=\"noopener\">ishort.su/user/api-clients</a>"

msgid "Test Connection"
msgstr "Проверить соединение"

msgid "Permission denied."
msgstr "Доступ запрещён."

msgid "URL is required."
msgstr "URL обязателен."

msgid "API token is not configured."
msgstr "API токен не настроен."

msgid "API error."
msgstr "Ошибка API."

msgid "Unexpected API response."
msgstr "Неожиданный ответ API."

msgid "Invalid token or connection failed."
msgstr "Неверный токен или ошибка соединения."

msgid "Invalid token."
msgstr "Неверный токен."

msgid "Settings"
msgstr "Настройки"

msgid "Connection successful!"
msgstr "Соединение успешно!"

msgid "Shortening..."
msgstr "Сокращаю..."

msgid "Go to settings"
msgstr "Перейти в настройки"

msgid "Please select a valid URL (http:// or https://)."
msgstr "Выделите корректный URL (http:// или https://)."

msgid "Error: "
msgstr "Ошибка: "

msgid "Copied!"
msgstr "Скопировано!"

msgid "Copy"
msgstr "Копировать"

msgid "Publish the post first."
msgstr "Сначала опубликуйте запись."

msgid "Shorten post URL"
msgstr "Сократить URL записи"

msgid "Short URL:"
msgstr "Короткая ссылка:"

msgid "Testing..."
msgstr "Проверяю..."

msgid "Shorten URL with iShort"
msgstr "Сократить URL через iShort"

msgid "API token is not configured. "
msgstr "API токен не настроен. "

msgid "Go to settings."
msgstr "Перейти в настройки."

msgid "iShort — Short URL"
msgstr "iShort — короткая ссылка"

msgid "To use this plugin you need a free account at <a href=\"%s\" target=\"_blank\" rel=\"noopener\">iShort.su</a> and an API token."
msgstr "Для использования плагина необходим бесплатный аккаунт на <a href=\"%s\" target=\"_blank\" rel=\"noopener\">iShort.su</a> и API токен."

msgid "Get your token on the <a href=\"%s\" target=\"_blank\" rel=\"noopener\">API clients page</a>."
msgstr "Получите токен на <a href=\"%s\" target=\"_blank\" rel=\"noopener\">странице API клиентов</a>."
